# Documentation-only public repository; executables are Release assets.
# Default deny; permit approved documentation formats and directories.
*
!/.gitignore
!/README.md
!/docs/
!/docs/**/
!/docs/**/*.md
!/docs/**/*.png
!/docs/**/*.jpg
!/docs/**/*.jpeg
!/docs/**/*.svg
!/demo/
!/demo/calistirma-talimatlari.md

# Explicit source, runtime, development, and secret exclusions.
*.exe
*.zip
*.dll
*.pyd
*.py
*.pyc
*.pyo
*.pyi
*.js
*.js.map
*.ts
*.tsx
*.cpp
*.c
*.h
*.pdb
*.map
*.env
.env
.env.*
.venv/
__pycache__/
build/
dist/
src/
tests/
tools/
models/
data/
training/
datasets/
packaging/
node_modules/
.codex/
.agents/
graphify-out/
